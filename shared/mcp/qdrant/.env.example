# Qdrant MCP — copie estas chaves para ~/.config/opencode/.env.mcp
# O instalador (linux/cli/install-qdrant-mcp.sh) lê esse arquivo.

# ── Embeddings (9Router, endpoint OpenAI-compatible) ───────────────────────
ROUTER_BASE_URL=http://127.0.0.1:20128/v1
ROUTER_API_KEY=<sua-chave-do-9router>
ROUTER_EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIMS=3072

# ── Qdrant (Cloud ou docker local) ─────────────────────────────────────────
# Cloud:  https://<cluster>.cloud.qdrant.io:6333
# Docker: http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=codebase
